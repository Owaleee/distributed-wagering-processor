PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wagering
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
WAGER_QUEUE_NAME=wager-transactions.fifo
WAGER_DLQ_NAME=wager-transactions-dlq.fifo
EVENTS_QUEUE_NAME=wallet-events.fifo
WAGER_MAX_RECEIVE_COUNT=5
WAGER_VISIBILITY_TIMEOUT_SECONDS=30

# Banco: espera máxima por lock de linha e por conexão do pool (ms) antes de responder 503
LOCK_TIMEOUT_MS=5000
DB_CONNECT_TIMEOUT_MS=5000

# Portas no host usadas pelo docker compose
POSTGRES_PORT=5432
SQS_PORT=4566
APP1_PORT=3001
APP2_PORT=3002
APP3_PORT=3003

# Consumidor SQS
CONSUMER_ENABLED=true
CONSUMER_WAIT_TIME_SECONDS=5
CONSUMER_RETRY_BASE_SECONDS=2
CONSUMER_RETRY_MAX_SECONDS=60
CONSUMER_SHUTDOWN_TIMEOUT_MS=20000

# Transações PENDING_REFERENCE: 1ª reavaliação em 2 s, as seguintes dobram; 8 tentativas ≈ 8,5 min de espera
PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_BASE_DELAY_MS=2000
PENDING_REFERENCE_MAX_ATTEMPTS=8
PENDING_REFERENCE_MAX_PROCESSING_FAILURES=5

# Publicador da outbox (eventos para wallet-events.fifo)
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=10

# Logs JSON: info (padrão), warn, error ou silent
LOG_LEVEL=info
